{
  "name": "@oxmumu3/dsh-agent-twin",
  "version": "0.5.0",
  "description": "DSH AI 分身工作台（1 个主分身 + 多项目只读能力包 + 5 通道本机长连接与物理隔离沙箱）",
  "type": "module",
  "license": "MIT",
  "author": "牛村木木山 <157776623+oxmumu3@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxmumu3/ai-twin-starter.git"
  },
  "main": "./index.js",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-twin": "./bin/agent-twin.mjs"
  },
  "files": [
    "bin/",
    "client.js",
    "cordis.patch.yml",
    "docs/",
    "examples/",
    "index.js",
    "lib/",
    "shared/",
    "src/",
    "templates/",
    "LICENSE",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/check-client.cjs",
    "prepack": "npm run build && npm run check:client",
    "test": "node --test test/scanner.test.mjs test/twin-engine.test.mjs test/channels-and-guest.test.mjs test/routes-and-store.test.mjs test/legacy-compat.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
