{
  "name": "@oxmumu3/dsh-agent-twin",
  "version": "0.4.0-preview.6",
  "description": "DSH-native AI twin: persistent project materials, evidence-backed capability versions, authorized channels, identity rules and service receipts.",
  "type": "module",
  "license": "MIT",
  "author": "牛村木木山",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxmumu3/ai-twin-starter.git"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-twin": "./bin/agent-twin.mjs"
  },
  "files": [
    "index.js",
    "src/",
    "bin/",
    "templates/",
    "examples/slack-app-manifest.json",
    "cordis.patch.yml",
    "README.md",
    "SETUP.md",
    "LICENSE",
    "docs/materials.md",
    "docs/channel.md",
    "docs/privacy.md",
    "docs/dsh-install.md",
    "docs/distill.md",
    "docs/native.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "compatibility:check": "node scripts/compatibility.mjs --latest"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.5 || 3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.5 || 3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "homepage": "https://github.com/oxmumu3/ai-twin-starter",
  "bugs": {
    "url": "https://github.com/oxmumu3/ai-twin-starter/issues"
  }
}
