{
  "name": "@oxmumu3/dsh-agent-twin",
  "version": "0.6.3",
  "description": "DSH AI 分身工作台（满血隔离 DSH Agent + 公开扫码真体验大厅 /try + 0.2.3 官方飞书/企微与真个人微信 iLink + 对话流与手机拍板 + 语义知识图谱）",
  "type": "module",
  "license": "MIT",
  "author": "牛村木木山 <157776623+oxmumu3@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxmumu3/ai-twin-starter.git"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-alpha.0 <0.2.4-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-twin": "./bin/agent-twin.mjs"
  },
  "files": [
    "bin/",
    "client.js",
    "cordis.patch.yml",
    "docs/",
    "examples/",
    "icon.svg",
    "index.js",
    "lib/",
    "locale/",
    "shared/",
    "src/",
    "templates/",
    "LICENSE",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/check-client.cjs",
    "test": "node --test test/scanner.test.mjs test/twin-engine.test.mjs test/channels-and-guest.test.mjs test/routes-and-store.test.mjs test/legacy-compat.test.mjs test/v6-connectors-and-fullblood.test.mjs test/v61-p0-p2-features.test.mjs test/v62-public-lobby.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ~4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-alpha.0 <0.2.3-0 || >=0.2.3-alpha.0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-alpha.0 <0.2.3-0 || >=0.2.3-alpha.0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2 || ~3.20.0-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
