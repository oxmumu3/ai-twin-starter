{
  "display_information": {
    "name": "Agent Twin Read-only Pilot",
    "description": "A bounded read-only channel verification and permissions dry-run pilot.",
    "background_color": "#263747"
  },
  "features": {
    "bot_user": { "display_name": "Agent Twin Pilot", "always_online": false },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": true }
